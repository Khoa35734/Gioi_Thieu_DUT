        position: relative;
        overflow: hidden;
    }

    .stats-wrapper::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: rgba(253, 195, 45, 0.1);
